# ---- Runtime ----
NODE_ENV=development
PORT=3000
# api | market | outbox | notifications | all (comma separated). Docker Compose runs each separately.
APP_ROLE=all
LOG_LEVEL=log
# LOG_JSON=true   # JSON logs (default in production)

# ---- Data stores ----
DATABASE_URL=postgresql://alerts:alerts@localhost:5432/crypto_alerts?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth (JWT_SECRET: at least 32 bytes, e.g. `openssl rand -base64 32`) ----
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_ABSOLUTE_TTL=90d
JWT_ISSUER=crypto-price-alerts
JWT_AUDIENCE=crypto-price-alerts-app

# ---- HTTP ----
# Browser origins allowed (native mobile apps don't need CORS). Comma separated.
CORS_ORIGINS=
TRUST_PROXY=true
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ---- Binance public market data (no API key). Check regional availability and data terms. ----
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com
MARKET_HEARTBEAT_TIMEOUT_MS=30000
MARKET_STALE_AFTER_MS=60000
MARKET_ROTATE_AFTER_MS=82800000
MARKET_MAX_BACKFILL_TRADES=100000
MARKET_QUEUE_MAX=10000
MARKET_CACHE_FLUSH_MS=250
MARKET_CHECKPOINT_INTERVAL_MS=5000
LEADER_LOCK_TTL_MS=15000

# ---- Real-time UI ----
UI_BROADCAST_INTERVAL_MS=1000

# ---- Alerts ----
ALERT_RESYNC_INTERVAL_MS=60000
MAX_ACTIVE_ALERTS_PER_USER=100

# ---- Outbox / notifications ----
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# Optional: required only if "Enhanced push security" is enabled for your Expo project.
EXPO_ACCESS_TOKEN=
NOTIFY_MAX_ATTEMPTS=6
RECEIPT_CHECK_DELAY_MS=900000
RECEIPT_CHECK_EVERY_MS=300000

# ---- Docker Compose host ports (change if already in use locally) ----
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_PORT=3000
