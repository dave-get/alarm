{
  "expo": {
    "name": "Crypto Price Alerts",
    "slug": "crypto-price-alerts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.cryptoalerts",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.cryptoalerts",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#F0B90B",
          "defaultChannel": "price-alarms",
          "sounds": ["./assets/sounds/alarm.wav"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "cryptoalerts",
    "extra": {
      "apiUrl": "http://localhost:3000",
      "eas": {
        "projectId": "56b18424-4aed-442b-8d33-5a9c6538bc39"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "dave-get"
  }
}
